# GitHub-visible local backend configuration template.
# Copy to backend/.env locally, replace placeholders, and never commit backend/.env.
# Real API keys and service-account JSON files must not be placed in this file.
PORT=8081
# CORS is disabled by default. Export this variable into the backend process.
# Local React/Vite development: CORS_ALLOWED_ORIGINS=http://localhost:5173
# Deployment: set the exact frontend origin, e.g. https://signbridge.example.com
# Multiple origins are comma-separated. No trailing slash, path, query, wildcard,
# or credentials. Restart the backend after changing this setting.
CORS_ALLOWED_ORIGINS=
# Keep this disabled in deployed environments. Set it to 1 only for local tests.
MOCK_EXTERNAL_SERVICES=0
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Vertex AI uses Application Default Credentials instead of an API key.
GEMINI_USE_VERTEX_AI=0
GOOGLE_CLOUD_LOCATION=global
# Provider RPC deadlines: finite seconds from 1 to 60; automatic retries disabled.
GEMINI_TIMEOUT_SECONDS=15
# Inclusive confidence/coverage threshold for segmented ML top_k candidates.
SIGNBRIDGE_RECOGNITION_THRESHOLD=0.50
# Google Cloud project used by Vertex AI, Firestore, Speech-to-Text, and TTS.
GOOGLE_CLOUD_PROJECT=replace-with-gcp-project-id
# Preferred local authentication is Application Default Credentials:
#   gcloud auth application-default login
# Leave this blank when using ADC. Never commit a service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
TTS_LANGUAGE_CODE=en-IN
TTS_VOICE_NAME=
TTS_HI_LANGUAGE_CODE=hi-IN
TTS_HI_VOICE_NAME=
TTS_VOICE_GENDER=NEUTRAL
TTS_TIMEOUT_SECONDS=15
STT_LANGUAGE_CODE=en-IN
STT_TIMEOUT_SECONDS=15
FIRESTORE_TIMEOUT_SECONDS=15
PUBLIC_BASE_URL=http://localhost:8081
# Set to 1 for deployment; Cloud Run (K_SERVICE) also enforces this automatically.
# Deployed mode requires an explicit HTTPS PUBLIC_BASE_URL (no request-host fallback).
REQUIRE_HTTPS_PUBLIC_BASE_URL=0
